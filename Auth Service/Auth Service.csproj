<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Auth_Service</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CustomExceptions\**" />
    <Compile Remove="Mappers\**" />
    <Compile Remove="Middlewares\**" />
    <Compile Remove="Services\**" />
    <Compile Remove="TokenService\**" />
    <Content Remove="CustomExceptions\**" />
    <Content Remove="Mappers\**" />
    <Content Remove="Middlewares\**" />
    <Content Remove="Services\**" />
    <Content Remove="TokenService\**" />
    <EmbeddedResource Remove="CustomExceptions\**" />
    <EmbeddedResource Remove="Mappers\**" />
    <EmbeddedResource Remove="Middlewares\**" />
    <EmbeddedResource Remove="Services\**" />
    <EmbeddedResource Remove="TokenService\**" />
    <None Remove="CustomExceptions\**" />
    <None Remove="Mappers\**" />
    <None Remove="Middlewares\**" />
    <None Remove="Services\**" />
    <None Remove="TokenService\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="10.0.0" />
    <PackageReference Include="MediatR.Extensions.Microsoft.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.0.0" />
  </ItemGroup>

</Project>
